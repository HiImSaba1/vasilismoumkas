# Admin authentication. Use a unique random secret of at least 32 characters.
ADMIN_USERNAME=VASILIS
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# MySQL/MariaDB. Required in production; without these variables local development
# temporarily reads the legacy JSON migration source.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moumkas_crm
DB_USER=moumkas_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=6
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Persistent runtime storage for standalone/release deployments. Point these at
# directories outside versioned releases. Leave both unset for normal local
# development, which keeps using public/uploads/portfolio and storage/client-files
# below the current project directory.
PORTFOLIO_UPLOADS_ROOT=
CLIENT_FILES_ROOT=

# Outbound CRM email. Keep credentials in the server environment only.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ENABLED=false
INQUIRY_NOTIFICATION_EMAIL=vasilis.moumkas@gmail.com
COLLABORATOR_CC_EMAIL=vasilis.moumkas@gmail.com

# Protects the Papaki cron endpoint POST /api/automations/run.
AUTOMATION_SECRET=
NEXT_PUBLIC_SITE_URL=https://vasilismoumkas.com
NEXT_PUBLIC_RECENT_GALLERY_URL=https://vasilismoumkas.pixieset.com/stamatisandnatasa/

# Optional Google Calendar OAuth connection. Enable the Google Calendar API,
# create a Web application OAuth client and register this exact production callback:
# https://vasilismoumkas.com/api/admin/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_REDIRECT_URI=
